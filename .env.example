# ─── Frontend (React/Vite) ────────────────────────────────────────────────────
# URL of the deployed Cloud Function for usage logging.
# Copy this from: gcloud functions describe certifyos-revert-logger --format="value(httpsTrigger.url)"
# Leave empty to disable logging (app still works normally).
VITE_LOG_ENDPOINT=https://us-central1-YOUR_PROJECT.cloudfunctions.net/certifyos-revert-logger

# ─── Cloud Function environment variables ─────────────────────────────────────
# Set these in GCP Console → Cloud Functions → Edit → Environment Variables
# (or pass with --set-env-vars when deploying)
GCP_PROJECT_ID="certifyos-production-platform"
BQ_DATASET_ID=certifyos_audit
BQ_TABLE_ID=workflow_revert_logs
ALLOWED_ORIGINS=http://localhost:5173,https://your-deployed-app.com
